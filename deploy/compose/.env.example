# Copy to deploy/compose/.env (gitignored) and fill the blanks: `make env`.
# Dev-only values. Nothing here is a production secret.

# --- pro_manage stack -------------------------------------------------------
POSTGRES_PASSWORD=change-me-dev
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=change-me-dev
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin-change-me
PM_LOG_FORMAT=json
PM_LOG_LEVEL=info
PM_VERSION=dev

# MDEMG the pm services talk to. `make dev` uses the dedicated stack below;
# `make dev-stub` overrides this to the stub container.
MDEMG_BASE_URL=http://host.docker.internal:9998
# One key shared by the dedicated MDEMG stack (AUTH_API_KEYS) and pm-core (X-API-Key).
# Generate: openssl rand -hex 24
MDEMG_API_KEY=

# --- dedicated MDEMG stack (docker-compose.mdemg.yml) -------------------------
MDEMG_NEO4J_PASS=change-me-dev
MDEMG_TSDB_PASSWORD=change-me-dev
# Generate: openssl rand -hex 32
MDEMG_J17_TICKET_SECRET=
# Local inference on the workstation (nothing leaves the machine)
MDEMG_LLM_ENDPOINT=http://host.docker.internal:8102/v1
MDEMG_LLM_MODEL=mdemg-llm-v1
MDEMG_OLLAMA_ENDPOINT=http://host.docker.internal:11434
MDEMG_EMBED_MODEL=nomic-embed-text

# --- host ports (defaults avoid the owner's other stacks) ----------------------
PM_POSTGRES_PORT=5440
PM_TSDB_PORT=5441
PM_REDIS_PORT=6380
PM_S3_PORT=9100
PM_S3_CONSOLE_PORT=9101
PM_KEYCLOAK_PORT=8180
PM_MAILPIT_UI_PORT=8026
PM_SMTP_PORT=1026
PM_CORE_PORT=8080
PM_WORKERS_PORT=8081
PM_SIDECAR_HTTP_PORT=7070
PM_SIDECAR_GRPC_PORT=7071
PM_FRONTEND_PORT=3100
PM_STUB_MDEMG_PORT=9997
PM_MDEMG_PORT=9998
PM_MDEMG_NEO4J_HTTP_PORT=7476
PM_MDEMG_NEO4J_BOLT_PORT=7689
PM_MDEMG_TSDB_PORT=5435
PM_MDEMG_SIDECAR_PORT=8103
