      },
      {
        "name": "pmo_lead",
        "description": "Runs the capital plan cycle for a portfolio"
      },
      {
        "name": "site_operations_lead",
        "description": "Per-site operations lead"
      },
      {
        "name": "site_maintenance_lead",
        "description": "Per-site maintenance lead"
      },
      {
        "name": "project_user",
        "description": "Any employee who can own or join projects"
      },
      {
        "name": "contributor",
        "description": "External EPCM / contractor staff, scoped by contract"
      }
    ]
  },
  "groups": [
    {
