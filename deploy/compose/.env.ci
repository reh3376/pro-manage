# Environment for PR CI's compose smoke test. Throwaway values; the stack is
# created and destroyed inside one job and never reachable from outside it.
POSTGRES_PASSWORD=ci-postgres
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=ci-keycloak
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=ci-rustfs-secret
PM_LOG_FORMAT=json
PM_LOG_LEVEL=info
PM_VERSION=ci
MDEMG_BASE_URL=http://stub-mdemg:9999
MDEMG_API_KEY=ci-stub-key
AUDIT_CHAIN_KEY=ci-audit-chain-key-0123456789abcdef0123456789abcdef
PM_DB_AUTO_MIGRATE=true
PM_DEV_ACTOR_HEADER=true
PM_WORKERS_TICK=2s
PM_OUTBOX_BASE_BACKOFF=2s
# CI: the CAR check sends repeat kinds quickly; a short dedupe window keeps them distinct.
COMMSI_DEDUPE_WINDOW=2s
