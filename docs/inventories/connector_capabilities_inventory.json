{
  "surface": "connector_capabilities",
  "description": "Every capability a connector manifest declares (connectors/<type>/<code>/connector.yaml) must have a pm-core consumer that routes on it (FSD \u00a715, \u00a712). Key: '<type>/<code>:<capability>'.",
  "entries": {
    "idpi/oidc:claims_to_roles": {
      "writers": [
        "connectors/idpi/oidc/connector.yaml"
      ],
      "readers": [
        "services/pm-core/internal/connectors/idpi/client.go",
        "services/pm-core/internal/auth/auth.go",
        "connectors/idpi/oidc/internal/service/service.go (Capabilities)",
        "docs/tests/udts/specs/idpi_oidc_connector_capabilities.udts.json"
      ],
      "disposition": "active",
      "notes": "ResolveClaimsToRoles from the mapping file; pm-core consumer: platform roles and approver pools on login (slice 4b, closes B-09)."
    },
    "idpi/oidc:interactive_login": {
      "writers": [
        "connectors/idpi/oidc/connector.yaml"
      ],
      "readers": [
        "services/pm-core/internal/connectors/idpi/client.go",
        "services/pm-core/internal/auth/auth.go",
        "connectors/idpi/oidc/internal/service/service.go (Capabilities)",
        "docs/tests/udts/specs/idpi_oidc_connector_capabilities.udts.json"
      ],
      "disposition": "active",
      "notes": "Authorization-code login (AuthenticateInteractive + CompleteAuthentication). pm-core consumer: the login routes of slice 4b."
    },
    "idpi/oidc:logout": {
      "writers": [
        "connectors/idpi/oidc/connector.yaml"
      ],
      "readers": [
        "services/pm-core/internal/connectors/idpi/client.go",
        "services/pm-core/internal/auth/auth.go",
        "connectors/idpi/oidc/internal/service/service.go (Capabilities)",
        "docs/tests/udts/specs/idpi_oidc_connector_capabilities.udts.json"
      ],
      "disposition": "active",
      "notes": "Revocation plus end-session URL; pm-core consumer: logout cascade (slice 4b)."
    },
    "idpi/oidc:pkce": {
      "writers": [
        "connectors/idpi/oidc/connector.yaml"
      ],
      "readers": [
        "services/pm-core/internal/connectors/idpi/client.go",
        "services/pm-core/internal/auth/auth.go",
        "connectors/idpi/oidc/internal/service/service.go (Capabilities)",
        "docs/tests/udts/specs/idpi_oidc_connector_capabilities.udts.json"
      ],
      "disposition": "active",
      "notes": "PKCE S256 on the code flow; pm-core keeps the verifier server-side."
    },
    "idpi/oidc:token_refresh": {
      "writers": [
        "connectors/idpi/oidc/connector.yaml"
      ],
      "readers": [
        "services/pm-core/internal/connectors/idpi/client.go",
        "services/pm-core/internal/auth/auth.go",
        "connectors/idpi/oidc/internal/service/service.go (Capabilities)",
        "docs/tests/udts/specs/idpi_oidc_connector_capabilities.udts.json"
      ],
      "disposition": "active",
      "notes": "RefreshToken; pm-core consumer: sliding sessions (slice 4b)."
    },
    "idpi/oidc:token_validation": {
      "writers": [
        "connectors/idpi/oidc/connector.yaml"
      ],
      "readers": [
        "services/pm-core/internal/connectors/idpi/client.go",
        "services/pm-core/internal/auth/auth.go",
        "connectors/idpi/oidc/internal/service/service.go (Capabilities)",
        "docs/tests/udts/specs/idpi_oidc_connector_capabilities.udts.json"
      ],
      "disposition": "active",
      "notes": "ValidateToken against the IdP JWKS; pm-core consumer: session validation (slice 4b)."
    }
  }
}
