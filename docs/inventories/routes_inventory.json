{
  "surface": "routes",
  "description": "Every HTTP route shipped by pro_manage services must be adjudicated here (FSD §12, DORMANT-CENSUS pattern). Key: '<binary> <METHOD> <path>'.",
  "entries": {
    "pm-core GET /api/v1/audit/verify": {
      "writers": [
        "services/pm-core/internal/api/api.go"
      ],
      "readers": [
        "docs/tests/uats/specs/pm-core/audit.uats.json",
        "services/pm-core/internal/store/integration_test.go"
      ],
      "disposition": "active",
      "notes": "Recomputes the tenant's audit hash chain; 409 when broken. The nightly verification job (FSD §08) will call this."
    },
    "pm-core GET /api/v1/mdemg/status": {
      "writers": [
        "services/pm-core/internal/api/mdemg.go"
      ],
      "readers": [
        "docs/tests/uats/specs/pm-core/mdemg_status.uats.json",
        "scripts/smoke.sh"
      ],
      "disposition": "active",
      "notes": "Reachability and Jiminy state of the configured MDEMG via pkg/mdemgadapter; 503 when unreachable."
    },
    "pm-core GET /api/v1/policy-variables": {
      "writers": [
        "services/pm-core/internal/api/api.go"
      ],
      "readers": [
        "docs/tests/uats/specs/pm-core/policy.uats.json"
      ],
      "disposition": "active",
      "notes": "Policy variable catalogue."
    },
    "pm-core GET /api/v1/projects": {
      "writers": [
        "services/pm-core/internal/api/api.go"
      ],
      "readers": [
        "docs/tests/uats/specs/pm-core/projects.uats.json"
      ],
      "disposition": "active",
      "notes": "List projects, optional ?site_id filter."
    },
    "pm-core GET /api/v1/projects/{project_id}": {
      "writers": [
        "services/pm-core/internal/api/api.go"
      ],
      "readers": [
        "docs/tests/uats/specs/pm-core/projects.uats.json"
      ],
      "disposition": "active",
      "notes": "Get a project."
    },
    "pm-core GET /api/v1/projects/{project_id}/audit": {
      "writers": [
        "services/pm-core/internal/api/api.go"
      ],
      "readers": [
        "docs/tests/uats/specs/pm-core/audit.uats.json"
      ],
      "disposition": "active",
      "notes": "Newest AuditEvents for a project (UC-12 retrieval, first cut)."
    },
    "pm-core GET /api/v1/projects/{project_id}/policy/{key}": {
      "writers": [
        "services/pm-core/internal/api/api.go"
      ],
      "readers": [
        "docs/tests/uats/specs/pm-core/policy.uats.json",
        "services/pm-core/internal/store/integration_test.go"
      ],
      "disposition": "active",
      "notes": "Effective policy value for the project (FSD §08 resolution order)."
    },
    "pm-core GET /api/v1/sites": {
      "writers": [
        "services/pm-core/internal/api/api.go"
      ],
      "readers": [
        "docs/tests/uats/specs/pm-core/sites.uats.json"
      ],
      "disposition": "active",
      "notes": "List sites for the tenant (FSD §03 Site)."
    },
    "pm-core GET /api/v1/sites/{site_id}": {
      "writers": [
        "services/pm-core/internal/api/api.go"
      ],
      "readers": [
        "docs/tests/uats/specs/pm-core/sites.uats.json"
      ],
      "disposition": "active",
      "notes": "Get a site."
    },
    "pm-core GET /healthz": {
      "writers": [
        "services/pm-core/cmd/pm-core/main.go"
      ],
      "readers": [
        "compose healthcheck",
        "scripts/smoke.sh",
        "docs/tests/uats/specs/pm-core/healthz.uats.json",
        "apps/pm-frontend/app/page.tsx"
      ],
      "disposition": "active",
      "notes": "Process liveness."
    },
    "pm-core GET /readyz": {
      "writers": [
        "services/pm-core/cmd/pm-core/main.go"
      ],
      "readers": [
        "scripts/smoke.sh",
        "docs/tests/uats/specs/pm-core/readyz.uats.json"
      ],
      "disposition": "active",
      "notes": "Dependency readiness; pings Postgres when DATABASE_URL is set."
    },
    "pm-core GET /version": {
      "writers": [
        "services/pm-core/cmd/pm-core/main.go"
      ],
      "readers": [
        "docs/tests/uats/specs/pm-core/version.uats.json"
      ],
      "disposition": "active",
      "notes": "Build version for operators and the frontend footer (later)."
    },
    "pm-core POST /api/v1/projects": {
      "writers": [
        "services/pm-core/internal/api/api.go"
      ],
      "readers": [
        "docs/tests/uats/specs/pm-core/projects.uats.json",
        "services/pm-core/internal/store/integration_test.go"
      ],
      "disposition": "active",
      "notes": "Create a project at Initiate; AuditEvent project.create in the same transaction."
    },
    "pm-core POST /api/v1/sites": {
      "writers": [
        "services/pm-core/internal/api/api.go"
      ],
      "readers": [
        "docs/tests/uats/specs/pm-core/sites.uats.json",
        "services/pm-core/internal/store/integration_test.go"
      ],
      "disposition": "active",
      "notes": "Create a site; AuditEvent site.create in the same transaction."
    },
    "pm-frontend GET /api/healthz": {
      "writers": [
        "apps/pm-frontend/app/api/healthz/route.ts"
      ],
      "readers": [
        "scripts/smoke.sh",
        "docs/tests/uats/specs/pm-frontend/healthz.uats.json"
      ],
      "disposition": "active",
      "notes": "Frontend liveness."
    },
    "pm-sidecar GET /healthz": {
      "source": "manual",
      "writers": [
        "services/pm-sidecar/src/pm_sidecar/main.py"
      ],
      "readers": [
        "scripts/smoke.sh",
        "docs/tests/uats/specs/pm-sidecar/healthz.uats.json",
        "apps/pm-frontend/app/page.tsx"
      ],
      "disposition": "active",
      "notes": "Python route; declared manually because the scanner reads Go and Next.js only."
    },
    "pm-sidecar GET /readyz": {
      "source": "manual",
      "writers": [
        "services/pm-sidecar/src/pm_sidecar/main.py"
      ],
      "readers": [
        "docs/tests/uats/specs/pm-sidecar/healthz.uats.json"
      ],
      "disposition": "active",
      "notes": "Same handler as /healthz until the sidecar has dependencies."
    },
    "pm-workers GET /healthz": {
      "writers": [
        "services/pm-core/cmd/pm-workers/main.go"
      ],
      "readers": [
        "scripts/smoke.sh",
        "docs/tests/uats/specs/pm-workers/healthz.uats.json",
        "apps/pm-frontend/app/page.tsx"
      ],
      "disposition": "active",
      "notes": "Process liveness."
    },
    "pm-workers GET /readyz": {
      "writers": [
        "services/pm-core/cmd/pm-workers/main.go"
      ],
      "readers": [
        "docs/tests/uats/specs/pm-workers/healthz.uats.json"
      ],
      "disposition": "active",
      "notes": "No dependencies yet; reports ready."
    },
    "stub-mdemg GET /healthz": {
      "writers": [
        "services/pm-core/cmd/stub-mdemg/main.go"
      ],
      "readers": [
        "scripts/smoke.sh",
        "docs/tests/uats/specs/stub-mdemg/healthz.uats.json"
      ],
      "disposition": "internal",
      "notes": "CI stand-in for MDEMG; mirrors MDEMG's /healthz."
    },
    "stub-mdemg GET /v1/jiminy/healthz": {
      "writers": [
        "services/pm-core/cmd/stub-mdemg/main.go"
      ],
      "readers": [
        "docs/tests/uats/specs/stub-mdemg/healthz.uats.json"
      ],
      "disposition": "internal",
      "notes": "Mirrors MDEMG's jiminy healthz: {status, enabled}."
    },
    "stub-mdemg GET /v1/jiminy/latest": {
      "writers": [
        "services/pm-core/cmd/stub-mdemg/main.go"
      ],
      "readers": [
        "docs/tests/uats/specs/stub-mdemg/warm_latest.uats.json"
      ],
      "disposition": "internal",
      "notes": "Mirrors MDEMG latest: {warm, status, data, age_ms, compute_ms, stale}."
    },
    "stub-mdemg POST /v1/conversation/observe": {
      "writers": [
        "services/pm-core/cmd/stub-mdemg/main.go"
      ],
      "readers": [
        "docs/tests/uats/specs/stub-mdemg/feedback_observe.uats.json"
      ],
      "disposition": "internal",
      "notes": "Mirrors MDEMG observe: 200 {obs_id, node_id, surprise_score, surprise_factors, summary}."
    },
    "stub-mdemg POST /v1/jiminy/classify": {
      "writers": [
        "services/pm-core/cmd/stub-mdemg/main.go"
      ],
      "readers": [
        "scripts/smoke.sh",
        "docs/tests/uats/specs/stub-mdemg/classify.uats.json"
      ],
      "disposition": "internal",
      "notes": "Mirrors MDEMG classify: {data: {verdict pass|deny, ...}}; 'stub:deny' in the payload denies."
    },
    "stub-mdemg POST /v1/jiminy/feedback": {
      "writers": [
        "services/pm-core/cmd/stub-mdemg/main.go"
      ],
      "readers": [
        "docs/tests/uats/specs/stub-mdemg/feedback_observe.uats.json"
      ],
      "disposition": "internal",
      "notes": "Mirrors MDEMG feedback: 400 without guidance_id, else 200 {guidance_id, results, applied}."
    },
    "stub-mdemg POST /v1/jiminy/guide": {
      "writers": [
        "services/pm-core/cmd/stub-mdemg/main.go"
      ],
      "readers": [
        "docs/tests/uats/specs/stub-mdemg/guide.uats.json"
      ],
      "disposition": "internal",
      "notes": "Mirrors MDEMG guide: {data: {guidance_id, guidance[], prompt_augmentation, confidence, rationale, source_counts}}."
    },
    "stub-mdemg POST /v1/jiminy/warm": {
      "writers": [
        "services/pm-core/cmd/stub-mdemg/main.go"
      ],
      "readers": [
        "docs/tests/uats/specs/stub-mdemg/warm_latest.uats.json"
      ],
      "disposition": "internal",
      "notes": "Mirrors MDEMG warm: 202 {status, age_ms, debounce_ms}."
    }
  }
}
