{
  "usts_version": "1.0.0",
  "test": {
    "name": "pm-core platform_admin_gate_sites",
    "description": "Creating a site is a platform-level write gated on platform_admin: a project owner without the role, a non-member, and an actor with other platform roles are 403; a platform admin passes the gate and reaches validation (422 on an empty body).",
    "category": "authorization",
    "severity": "critical",
    "endpoint": "/api/v1/sites",
    "method": "POST"
  },
  "requests": [
    {
      "name": "owner_without_role",
      "headers": {
        "X-Dev-Actor": "alice.owner"
      },
      "payload": {},
      "expected_status": 403
    },
    {
      "name": "nobody",
      "headers": {
        "X-Dev-Actor": "nobody.usts"
      },
      "payload": {},
      "expected_status": 403
    },
    {
      "name": "other_platform_roles",
      "headers": {
        "X-Dev-Actor": "evan.exec",
        "X-Dev-Roles": "portfolio_executive,compliance_officer"
      },
      "payload": {},
      "expected_status": 403
    },
    {
      "name": "platform_admin_reaches_validation",
      "headers": {
        "X-Dev-Actor": "carol.admin",
        "X-Dev-Roles": "platform_admin"
      },
      "payload": {},
      "expected_status": 422
    }
  ],
  "assertions": {
    "status_in": [
      403,
      422
    ],
    "body_not_contains": [
      "site_id"
    ]
  },
  "metadata": {
    "owasp": [
      "A01:2021 Broken Access Control"
    ],
    "cwe": [
      "CWE-285"
    ],
    "references": [
      "docs/fsd/04-access-control-and-identity.md",
      "docs/fsd/12-test-governance-uxts.md"
    ]
  }
}
