{
  "usts_version": "1.0.0",
  "test": {
    "name": "pm-core project_create_injection",
    "description": "Project creation validates every field: SQL and script fragments in code and name are rejected (422); the body never shows a database error.",
    "category": "injection",
    "severity": "medium",
    "endpoint": "/api/v1/projects",
    "method": "POST"
  },
  "requests": [
    {
      "name": "sql_in_code",
      "headers": {
        "X-Dev-Actor": "alice.owner"
      },
      "payload": {
        "code": "P'; DROP TABLE projects; --",
        "name": "x",
        "site_id": "01900000-0000-7000-8000-00000000a001",
        "project_type": "reliability",
        "fel_stage": "fel1"
      },
      "expected_status": 422
    },
    {
      "name": "script_in_code",
      "headers": {
        "X-Dev-Actor": "alice.owner"
      },
      "payload": {
        "code": "<script>alert(1)</script>",
        "name": "x",
        "site_id": "01900000-0000-7000-8000-00000000a001",
        "project_type": "reliability",
        "fel_stage": "fel1"
      },
      "expected_status": 422
    },
    {
      "name": "oversized_code",
      "headers": {
        "X-Dev-Actor": "alice.owner"
      },
      "payload": {
        "code": "",
        "name": "x",
        "site_id": "01900000-0000-7000-8000-00000000a001",
        "project_type": "reliability",
        "fel_stage": "fel1"
      },
      "expected_status": 422
    }
  ],
  "assertions": {
    "status_in": [
      422
    ],
    "body_not_contains": [
      "SQLSTATE",
      "syntax error",
      "pgx"
    ]
  },
  "metadata": {
    "owasp": [
      "A03:2021 Injection"
    ],
    "cwe": [
      "CWE-89",
      "CWE-79",
      "CWE-20"
    ],
    "references": [
      "docs/fsd/04-access-control-and-identity.md",
      "docs/fsd/12-test-governance-uxts.md"
    ]
  }
}
