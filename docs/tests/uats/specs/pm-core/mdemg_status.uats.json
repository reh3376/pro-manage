{
  "uats_version": "1.0.0",
  "api": {
    "name": "pm-core mdemg status",
    "base_url": "${PM_CORE_URL:-http://127.0.0.1:8080}",
    "service": "pm-core",
    "tags": [
      "pm-core",
      "api",
      "mdemg"
    ]
  },
  "metadata": {
    "author": "reh3376",
    "created": "2026-10-22",
    "description": "pm-core's view of its MDEMG dependency through pkg/mdemgadapter (FSD \u00a706). In the compose stack the target is the stub; reachable and jiminy_enabled must be true.",
    "status": "active",
    "test_type": "contract",
    "priority": "high"
  },
  "config": {
    "timeout_ms": 10000,
    "sha256": "e71c50c8b32bc108e893b67362c7d4e93b08e7c898229df73042a9da3c4f94c4"
  },
  "request": {
    "method": "GET",
    "path": "/api/v1/mdemg/status",
    "headers": {
      "X-Dev-Actor": "alice.owner"
    }
  },
  "expected": {
    "status": 200,
    "body_assertions": [
      {
        "name": "configured",
        "path": "$.configured",
        "op": "equals",
        "expected": true
      },
      {
        "name": "reachable",
        "path": "$.reachable",
        "op": "equals",
        "expected": true
      },
      {
        "name": "jiminy enabled",
        "path": "$.jiminy_enabled",
        "op": "equals",
        "expected": true
      },
      {
        "name": "latency number",
        "path": "$.latency_ms",
        "op": "type_is",
        "expected": "number"
      },
      {
        "name": "base_url string",
        "path": "$.base_url",
        "op": "type_is",
        "expected": "string"
      }
    ]
  },
  "variants": [
    {
      "name": "missing_dev_actor_401",
      "request": {
        "headers": {
          "X-Dev-Actor": ""
        }
      },
      "expected": {
        "status": 401,
        "body_assertions": []
      }
    }
  ]
}
